{
  "name": "shopit",
  "version": "1.0.0",
  "description": "full ecommerece site using MERN.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "prod": "node server/server.js --production",
    "seeder": "node server/utils/seeder.js",
    "test": "node scripts/test.js",
    "test:server": "node client/node_modules/jest/bin/jest.js --config server/jest.config.js --runInBand",
    "test:client": "npm --prefix client test -- --watchAll=false --runInBand",
    "test:database": "node scripts/test-database.js"
  },
  "author": "Asim Razzaq",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "4.22.3",
    "express-fileupload": "1.5.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "nodemailer": "10.2.1",
    "stripe": "23.0.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
